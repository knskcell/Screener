name: Daily Stock Scan

on:
  schedule:
    # Runs at 22:00 UTC = 5:30 PM ET (after US market close + 30 min buffer)
    - cron: '0 22 * * 1-5'   # Monday–Friday only
  workflow_dispatch:           # Allow manual trigger from GitHub UI anytime

jobs:
  scan:
    runs-on: ubuntu-latest
    timeout-minutes: 180       # 3-hour max (8,000 stocks needs ~2 hrs)

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: 'pip'

      - name: Install dependencies
        run: pip install yfinance pandas lxml requests

      - name: Run stock scanner
        env:
          SCAN_WORKERS: "14"
        run: python scanner/scan.py

      - name: Commit and push data
        run: |
          git config user.name  "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add docs/data/
          git diff --staged --quiet || git commit -m "Daily scan: $(date -u '+%Y-%m-%d %H:%M UTC')"
          git push
